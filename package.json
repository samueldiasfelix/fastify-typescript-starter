{
  "name": "fastify-typescript-starter",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.14.0"
  },
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "biome lint --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/awilix": "^8.3.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/redis": "^9.0.1",
    "@fastify/session": "^11.1.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/throttle": "^3.0.4",
    "@fastify/type-provider-typebox": "^6.2.0",
    "@fastify/under-pressure": "^9.2.1",
    "@scalar/fastify-api-reference": "^1.73.1",
    "awilix": "^13.0.5",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
