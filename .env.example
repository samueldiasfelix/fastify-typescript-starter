# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Proxy
# Trusted proxy IPs/CIDRs, separated by commas.
# Leave empty when running without a reverse proxy.
TRUST_PROXY=

# CORS
# Allowed origins, separated by commas.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookies
# Generate with: openssl rand -hex 32
COOKIE_SECRET=replace-with-a-secure-random-secret-generated-locally

# JWT
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-secret-generated-locally

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/app